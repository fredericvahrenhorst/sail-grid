# Copy to .env and replace the two passwords. .env is gitignored.
# Do not deploy these example values. They are in the public repository,
# and production refuses them.
# Do not set NODE_ENV here. `pnpm dev` is development, the Docker image is production.
# Local MongoDB. Compose starts Mongo only for deployment.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sailgrid

# Local `pnpm dev` only. Docker and production require at least 12 characters
# and reject "change-me" and "root".
ADMIN_PASSWORD=change-me

# At least 32 characters. Generate with: openssl rand -base64 32
# Production rejects the placeholder below.
NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters

# Public base URL (share links and ICS). Also read as NUXT_PUBLIC_BASE_URL.
NUXT_PUBLIC_BASE_URL=http://localhost:3000

# Interface language. de or en. There is no language switcher. Default de.
NUXT_PUBLIC_LANG=de

# CSP frame-ancestors source list. Keyword "self" is quoted by the app.
# Example: self https://verein.example
ALLOWED_FRAME_ANCESTORS=self
